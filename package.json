{
  "name": "islandcn-arch",
  "version": "1.0.0",
  "private": true,
  "description": "A Dynamic Island-style status pill for Linux desktops (GNOME, KDE Plasma, Hyprland, generic X11), built on the islandcn engine.",
  "license": "MIT",
  "author": "islandcn-arch",
  "homepage": "https://github.com/opencoredev/islandcn",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "npm run build:main && vite build --watch & electron .",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --linux AppImage --publish never"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "4.4.0",
    "@hugeicons/react": "1.1.10",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "45.3.2",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "dev.islandcn.arch",
    "productName": "islandcn-arch",
    "executableName": "islandcn-arch",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "packaging/icon.png",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "artifactName": "islandcn-arch-${version}-x86_64.AppImage",
      "icon": "packaging/icon.png"
    }
  }
}